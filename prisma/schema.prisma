generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailLog {
  id            Int       @id @default(autoincrement())
  recipient     String
  subject       String
  mail_type MailType
  sentAt        DateTime @default(now())
  status        EmailStatus @default(pending)
  errorMessage  String?
  publicId      String?
  clientName    String?
  sentBy String
  gymPublicId       String?
  gymName           String?
  dailyLimit        Int?
  localDay          String   @db.VarChar(10)
  providerMessageId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([gymPublicId, localDay])
  @@index([localDay])
  @@map("mail_logs")
}

enum MailType {
  plan_renovation_reminder
  admin_reminder
  app_release
  campaign_email
  daily_admin_report
  daily_sales_report
  password_reset
  client_password_reset
  platform_user_credentials
  client_app_invitation
  manager_welcome
  staff_welcome
  payment_link
  low_stock_alert
  sales_order_to_factory
  trainer_email_verification
  trainer_account_exists
  trainer_invitation
}

enum EmailStatus {
  pending
  sent
  failed
  blocked
}
